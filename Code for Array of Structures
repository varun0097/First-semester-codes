include <stdio.h>

struct Student {
    int rollNo;
    char name[50];
    float marks[3];
    float total;
    float percentage;
};

int main () {
    struct Student students[3];
    int i, j;

    // Input loop to gather details for each student
    for (i = 0; i < 3; i++) {
        printf("Enter details for Student %d\n", i + 1);
        
        printf("Enter Roll Number: ");
        scanf("%d", &students[i].rollNo);
        
        printf("Enter Name: ");
        scanf("%s", students[i].name);
        
        students[i].total = 0;
      
        for (j = 0; j < 3; j++) {
            printf("Enter Marks for Subject %d: ", j + 1);
            scanf("%f", &students[i].marks[j]);
            students[i].total += students[i].marks[j]; 
        }
      
        students[i].percentage = students[i].total / 3.0;
        printf("\n");
  }
    printf("==========================================\n");
    printf("             STUDENT RECORDS             \n");
    printf("==========================================\n");
    
    for (i = 0; i < 3; i++) {
        printf("Roll No: %d\n", students[i].rollNo);
        printf("Name: %s\n", students[i].name);
        printf("Marks: Sub1: %.2f, Sub2: %.2f, Sub3: %.2f\n", 
               students[i].marks[0], students[i].marks[1], students[i].marks[2]);
        printf("Total Marks: %.2f\n", students[i].total);
        printf("Percentage: %.2f%%\n", students[i].percentage);
        printf("------------------------------------------\n");
    }

    return 0;
}
